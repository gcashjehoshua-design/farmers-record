# Farmers Record System - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
NODE_ENV=production

# Database (SQLite uses a local file, no additional config needed)
# Database file will be created automatically at backend/database/farmers_record.db

# API Configuration
API_BASE_URL=http://localhost:3000

# For production, update API_BASE_URL to your Railway domain
# Example: API_BASE_URL=https://your-app.railway.app
